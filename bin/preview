#!/usr/bin/env ruby
# Usage: bin/push --dry-run --sample-events | bin/preview
#        bin/preview payload.json
# Writes tmp/preview.html. Open it in a browser; it loads TRMNL's CSS from trmnl.com.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "fileutils"
require "json"
require "template"

output = File.expand_path("../tmp/preview.html", __dir__)
FileUtils.mkdir_p(File.dirname(output))
File.write(output, Template.new.preview_page(JSON.parse(ARGF.read)))
puts output
