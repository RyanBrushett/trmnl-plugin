#!/usr/bin/env ruby
# Usage: bin/google_auth
# One-off: gets a Google Calendar refresh token. Needs GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET (from .env or the environment). Instructions go to
# stderr and only the token goes to stdout, so it can be captured:
#   token=$(bin/google_auth)

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "dotenv"
Dotenv.load(File.expand_path("../.env", __dir__))

require "consent_flow"
require "loopback_receiver"

missing = %w[GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET].select { |name| ENV[name].to_s.strip.empty? }
abort "missing environment variables: #{missing.join(", ")}" if missing.any?

receiver = LoopbackReceiver.new
flow = ConsentFlow.new(client_id: ENV["GOOGLE_CLIENT_ID"], client_secret: ENV["GOOGLE_CLIENT_SECRET"], base_url: receiver.base_url)

warn "Opening Google's consent page. If it does not open, paste this into your browser:\n\n#{flow.authorization_url}\n"
system("open", flow.authorization_url) if RUBY_PLATFORM.include?("darwin")

begin
  code = receiver.wait_for_code(expected_state: flow.state)
  puts flow.refresh_token_for(code)
  warn "Done. Keep that token private; it is read-only access to your calendar events."
rescue LoopbackReceiver::Error, Signet::AuthorizationError => error
  abort "google_auth failed: #{error.message}"
ensure
  receiver.close
end
